# Application Environment
APP_ENV=development
DEBUG=False
PORT=5000
ALLOW_DEMO_LOGIN=False

# Firebase Configuration
# Copy your Firebase service account JSON file and reference it here
# Or set the path to your service account JSON key
FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id

# Gemini Configuration (for recommendations and motivation)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Legacy fallback (optional): if you already stored Gemini key here, code can still read it
OPENAI_API_KEY=

# Google Vision API (for image verification)
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_VISION_API_KEY=your_vision_api_key

# CORS Configuration
# Add your frontend domains here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://yourdomain.com

# Optional: Protect scheduler-triggered endpoints (like /api/plants/batch-decay)
CRON_SECRET=change-me

# Database (Firestore is configured through Firebase Admin SDK)
# No additional database config needed - Firestore is managed via FIREBASE_*

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bloomy.log
